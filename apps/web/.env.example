# AcadFlows Web — Environment Variables
#
# The API base URL. Use the full backend URL in production, or a relative
# path (via Vite's proxy) in development.
#
# Local dev (uses vite.config.ts proxy):
#   VITE_API_URL=/api/v1
#
# Production:
#   VITE_API_URL=https://acadflows.onrender.com/api/v1

VITE_API_URL=http://localhost:5000/api/v1