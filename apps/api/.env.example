NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/acadflows

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Tenant
DEFAULT_TENANT_ID=default

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5173

# Email (Resend) — optional
# Get an API key at https://resend.com/api-keys
# If unset, emails are logged to console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=AcadFlows <noreply@acadflows.in>

# File Storage (Cloudflare R2 - optional for MVP)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=